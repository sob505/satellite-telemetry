{
  "dataset_name": "satellite_telemetry",
  "description": "Telemetry and channel data for anomaly detection tasks",
  "global_rules": [
    "Use pandas to read CSV files",
    "Access columns by name (df['column'])",
    "Do not assume columns exist unless listed in schema",
    "Prefer vectorized pandas operations over loops"
  ],
  "files": [
    {
      "filename": "data/sample_telemetry.csv",
      "role": "primary_telemetry",
      "time_series": true,
      "joinable": false,
      "columns": [
        {
          "name": "timestamp",
          "type": "datetime",
          "description": "UTC timestamp of telemetry record",
          "example": "2024-01-01T00:00:00Z"
        },
        {
          "name": "satellite_id",
          "type": "string",
          "description": "Unique satellite identifier",
          "example": "SAT-001"
        },
        {
          "name": "altitude_km",
          "type": "float",
          "unit": "km",
          "expected_range": [350, 450]
        },
        {
          "name": "temperature_c",
          "type": "float",
          "unit": "C",
          "expected_range": [-40, 80]
        },
        {
          "name": "signal_strength_dbm",
          "type": "float",
          "unit": "dBm",
          "expected_range": [-120, -30]
        },
        {
          "name": "solar_panel_voltage_v",
          "type": "float",
          "unit": "V",
          "expected_range": [0, 100]
        },
        {
          "name": "battery_charge_percent",
          "type": "float",
          "unit": "%",
          "expected_range": [0, 100]
        },
        {
          "name": "status",
          "type": "string",
          "description": "Operational status flag",
          "allowed_values": ["OK", "WARN", "FAIL"]
        }
      ],
      "sample_rows": [
        {
          "timestamp": "2024-01-01T00:00:00Z",
          "satellite_id": "SAT-001",
          "altitude_km": 410.2,
          "temperature_c": 35.1,
          "signal_strength_dbm": -72.5,
          "solar_panel_voltage_v": 48.3,
          "battery_charge_percent": 87.4,
          "status": "OK"
        },
        {
          "timestamp": "2024-01-01T00:01:00Z",
          "satellite_id": "SAT-001",
          "altitude_km": 389.7,
          "temperature_c": 78.9,
          "signal_strength_dbm": -110.2,
          "solar_panel_voltage_v": 12.1,
          "battery_charge_percent": 22.5,
          "status": "WARN"
        }
      ],
      "anomaly_hints": [
        "Sudden drops in signal_strength_dbm",
        "Battery_charge_percent below 20%",
        "Temperature_c outside expected range",
        "Voltage near zero while status is OK"
      ]
    },
    {
      "filename": "data/channel_1.csv",
      "role": "auxiliary_channel",
      "time_series": false,
      "joinable": false,
      "columns": [
        {
          "name": "channel_1",
          "type": "float"
        }
      ],
      "constraints": [
        "Single-column file",
        "Do not combine with telemetry data"
      ]
    },
    {
      "filename": "data/channel_2.csv",
      "role": "auxiliary_channel",
      "time_series": false,
      "joinable": false,
      "columns": [
        {
          "name": "channel_2",
          "type": "float"
        }
      ],
      "constraints": [
        "Single-column file",
        "Do not combine with telemetry data"
      ]
    }
  ]
}
